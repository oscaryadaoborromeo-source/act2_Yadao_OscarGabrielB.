<?php

$grade_Yadao = 90;

if ($grade_Yadao >= 80.5) {
    $resulta_Yadao = "Passed";
} else {
    $resulta_Yadao = "Failed";
}

if ($grade_Yadao >= 90) {
    $letter_grade = "A";
} elseif ($grade_Yadao >= 80) {
    $letter_grade = "B";
} elseif ($grade_Yadao >= 75) {
    $letter_grade = "C";
} elseif ($grade_Yadao >= 70) {
    $letter_grade = "D";
} else {
    $letter_grade = "F";
}

echo "Grade: " . $grade_Yadao . "<br>";
echo "Remark: " . $resulta_Yadao . "<br>";
echo "Letter Grade: " . $letter_grade . "<br>";

